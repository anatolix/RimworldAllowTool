<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>NU1701;NU1603</NoWarn>
    <RootNamespace>AllowTool</RootNamespace>
    <AssemblyName>AllowTool</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <Optimize>true</Optimize>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>Mods\AllowTool\v1.7\Assemblies\</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <RimWorldVersion>1.7.4985-unstable</RimWorldVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source\**\*.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldVersion)" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.3" ExcludeAssets="runtime" />
    <PackageReference Include="UnlimitedHugs.Rimworld.HugsLib" Version="12.0.0" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <!-- HugsLib 12 is a net472 build referencing Unity module assemblies by name; see Tools/UnityFacades -->
    <Reference Include="UnityEngine.CoreModule"><HintPath>Tools\UnityFacades\bin\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>Tools\UnityFacades\bin\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>Tools\UnityFacades\bin\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
